<Window x:Class="Mixline.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cuebox"
        Width="340" Height="148"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#101114"
        Foreground="#E8E9ED">
  <Border BorderBrush="#2C2F36" BorderThickness="1">
    <Grid Margin="22,20,22,18">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="32" Height="32" CornerRadius="6" ClipToBounds="True" Margin="0,0,12,0">
          <Image Source="Assets/cuebox.png" Stretch="UniformToFill"/>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Cuebox" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock x:Name="Line" Text="loading" Foreground="#6E7580" FontSize="12" Margin="0,2,0,0"/>
        </StackPanel>
      </StackPanel>
      <Border Grid.Row="1" Height="2" Background="#1C1E24" Margin="0,16,0,0">
        <Border x:Name="Bar" Width="48" Height="2" HorizontalAlignment="Left" Background="#C9A36A"/>
      </Border>
    </Grid>
  </Border>
</Window>
