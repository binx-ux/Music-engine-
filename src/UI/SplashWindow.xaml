<Window x:Class="Mixline.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cuebox"
        Icon="Assets/cuebox.ico"
        Width="500" Height="288"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        Foreground="#E8E9ED"
        FontFamily="Segoe UI Variable Display, Segoe UI">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" GlassFrameThickness="0" CornerRadius="12" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Border BorderBrush="#50C9A36A" BorderThickness="1" CornerRadius="12" Background="#12141A">
    <Grid>
      <Border Width="5" HorizontalAlignment="Left" Background="#C9A36A" CornerRadius="12,0,0,12"/>
      <Border HorizontalAlignment="Right" Width="180" Opacity="0.09" IsHitTestVisible="False">
        <Border.Background>
          <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
            <GradientStop Color="#C9A36A" Offset="0"/>
            <GradientStop Color="#00000000" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <Grid Margin="32,28,28,24">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel>
          <Border x:Name="Mark" Width="76" Height="76" CornerRadius="16" ClipToBounds="True" Margin="0,0,18,0"
                  DockPanel.Dock="Left" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
              <ScaleTransform x:Name="MarkScale" ScaleX="0.82" ScaleY="0.82"/>
            </Border.RenderTransform>
            <Image Source="Assets/cuebox.png" Stretch="UniformToFill"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="CUEBOX" FontSize="11" FontWeight="Bold" Foreground="#8E96A6" Margin="0,0,0,6"/>
            <TextBlock Text="Cuebox" FontSize="32" FontWeight="SemiBold"/>
            <TextBlock Text="Mic, music, and pads in one mix" FontSize="13" Foreground="#8E96A6" Margin="0,6,0,0"/>
          </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1" Margin="0,18,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,16,2">
            <Border Width="9" Height="32" CornerRadius="3" Background="#1AFFFFFF" ClipToBounds="True" Margin="0,0,5,0">
              <Border Background="#C9A36A" CornerRadius="3" RenderTransformOrigin="0.5,1">
                <Border.RenderTransform>
                  <ScaleTransform x:Name="Meter1" ScaleY="0.18"/>
                </Border.RenderTransform>
              </Border>
            </Border>
            <Border Width="9" Height="32" CornerRadius="3" Background="#1AFFFFFF" ClipToBounds="True" Margin="0,0,5,0">
              <Border Background="#C9A36A" CornerRadius="3" RenderTransformOrigin="0.5,1">
                <Border.RenderTransform>
                  <ScaleTransform x:Name="Meter2" ScaleY="0.12"/>
                </Border.RenderTransform>
              </Border>
            </Border>
            <Border Width="9" Height="32" CornerRadius="3" Background="#1AFFFFFF" ClipToBounds="True">
              <Border Background="#C9A36A" CornerRadius="3" RenderTransformOrigin="0.5,1">
                <Border.RenderTransform>
                  <ScaleTransform x:Name="Meter3" ScaleY="0.08"/>
                </Border.RenderTransform>
              </Border>
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
            <TextBlock x:Name="Line" Text="Starting" FontSize="13" FontWeight="SemiBold" Foreground="#E8D4B0" Margin="0,0,0,8"/>
            <Border Height="4" Background="#1AFFFFFF" CornerRadius="2" ClipToBounds="True">
              <Border HorizontalAlignment="Stretch" Height="4" Background="#C9A36A" CornerRadius="2"
                      RenderTransformOrigin="0,0.5">
                <Border.RenderTransform>
                  <ScaleTransform x:Name="FillScale" ScaleX="0.06"/>
                </Border.RenderTransform>
              </Border>
            </Border>
          </StackPanel>
          <TextBlock x:Name="Ver" Grid.Column="2" VerticalAlignment="Bottom" Margin="14,0,0,0"
                     FontSize="12" Foreground="#6E7580"/>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
