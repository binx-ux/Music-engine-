<Window x:Class="Mixline.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cuebox"
        Width="448" Height="252"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#16181E"
        Foreground="#E8E9ED"
        FontFamily="Segoe UI Variable Display, Segoe UI">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" GlassFrameThickness="0" CornerRadius="10" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Border BorderBrush="#40C9A36A" BorderThickness="1" CornerRadius="10" Background="#16181E">
    <Grid>
      <Border Width="4" HorizontalAlignment="Left" Background="#C9A36A" CornerRadius="10,0,0,10"/>
      <Grid Margin="28,26,26,22">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Border x:Name="Mark" Width="52" Height="52" CornerRadius="10" ClipToBounds="True" Margin="0,0,16,0"
                    RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform>
                <ScaleTransform x:Name="MarkScale" ScaleX="0.88" ScaleY="0.88"/>
              </Border.RenderTransform>
              <Image Source="Assets/cuebox.png" Stretch="UniformToFill"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="CUEBOX" FontSize="11" FontWeight="Bold" Foreground="#8E96A6" Margin="0,0,0,4"/>
              <TextBlock Text="Cuebox" FontSize="28" FontWeight="SemiBold"/>
              <TextBlock Text="Mic, music, and pads in one mix" FontSize="13" Foreground="#8E96A6" Margin="0,4,0,0"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>
        <DockPanel Grid.Row="1">
          <TextBlock x:Name="Ver" DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="12,0,0,0"
                     FontSize="11" Foreground="#6E7580"/>
          <StackPanel>
            <TextBlock x:Name="Line" Text="Starting" FontSize="13" Foreground="#C9A36A" Margin="0,0,0,10"/>
            <Border Height="3" Background="#22FFFFFF" CornerRadius="2" ClipToBounds="True">
              <Border HorizontalAlignment="Stretch" Height="3" Background="#C9A36A" CornerRadius="2"
                      RenderTransformOrigin="0,0.5">
                <Border.RenderTransform>
                  <ScaleTransform x:Name="FillScale" ScaleX="0.08"/>
                </Border.RenderTransform>
              </Border>
            </Border>
          </StackPanel>
        </DockPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
