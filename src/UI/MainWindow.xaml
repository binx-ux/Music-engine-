<Window x:Class="Mixline.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cuebox"
        Icon="Assets/cuebox.ico"
        Height="900" Width="1360" MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        FontSize="13"
        Opacity="0"
        StateChanged="WinState">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="8" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Border BorderBrush="{DynamicResource WindowEdge}" BorderThickness="1" CornerRadius="8" Background="Transparent">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="42"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="104"/>
        <RowDefinition Height="28"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.RowSpan="4" Grid.ColumnSpan="2" Background="{DynamicResource WindowSheen}" Opacity="0.10" IsHitTestVisible="False"/>
      <Border Grid.RowSpan="4" Grid.ColumnSpan="2" Background="{StaticResource GrainBrush}" Opacity="0.008" IsHitTestVisible="False"/>

      <Border Grid.RowSpan="2" Background="#C80C0E12" BorderBrush="#14FFFFFF" BorderThickness="0,0,1,0">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="16,16,16,10">
            <StackPanel Orientation="Horizontal">
              <Border Width="36" Height="36" CornerRadius="9" ClipToBounds="True" Margin="0,0,10,0">
                <Image Source="Assets/cuebox.png" Stretch="UniformToFill"/>
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Cuebox" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock x:Name="SideVer" Text="1.5.0" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border DockPanel.Dock="Bottom" Padding="14,10,14,16">
            <StackPanel>
              <TextBlock x:Name="SideEngine" Text="Engine off" FontSize="12" FontWeight="SemiBold"/>
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Ellipse x:Name="SideDot" Width="7" Height="7" Fill="#666" Margin="0,0,7,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="SideVirt" Text="No cable" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8,4,8,4">
            <StackPanel>
              <TextBlock Text="MIX" Style="{StaticResource Kicker}" Margin="12,6,0,6"/>
              <RadioButton x:Name="NavHome" Style="{StaticResource NavBtn}" Checked="NavChanged" IsChecked="True">
                <StackPanel Orientation="Horizontal">
                  <Path Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" Fill="{x:Null}"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                        StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        Data="M 4,11 L 12,4.5 L 20,11 V 20 H 15.2 V 14.2 H 8.8 V 20 H 4 Z"/>
                  <TextBlock Text="Home" VerticalAlignment="Center"/>
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="NavMixer" Style="{StaticResource NavBtn}" Checked="NavChanged">
                <StackPanel Orientation="Horizontal">
                  <Path Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" Fill="{x:Null}"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                        StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        Data="M 6,3 V 21 M 6,9 H 3.6 M 6,9 H 8.4 M 12,3 V 21 M 12,15 H 9.6 M 12,15 H 14.4 M 18,3 V 21 M 18,8 H 15.6 M 18,8 H 20.4"/>
                  <TextBlock Text="Mixer" VerticalAlignment="Center"/>
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="NavBoard" Style="{StaticResource NavBtn}" Checked="NavChanged">
                <StackPanel Orientation="Horizontal">
                  <Path Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" Fill="{x:Null}"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                        StrokeThickness="1.6" StrokeLineJoin="Round"
                        Data="M 3.5,3.5 H 10 V 10 H 3.5 Z M 14,3.5 H 20.5 V 10 H 14 Z M 3.5,14 H 10 V 20.5 H 3.5 Z M 14,14 H 20.5 V 20.5 H 14 Z"/>
                  <TextBlock Text="Board" VerticalAlignment="Center"/>
                </StackPanel>
              </RadioButton>
              <TextBlock Text="AUDIO" Style="{StaticResource Kicker}" Margin="12,18,0,6"/>
              <RadioButton x:Name="NavMusic" Style="{StaticResource NavBtn}" Checked="NavChanged">
                <StackPanel Orientation="Horizontal">
                  <Path Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"
                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                        Data="M 8,4.2 L 17.5,2.2 V 8.2 L 8,10.2 V 16.6 A 2.6,2.6 0 1 1 5.6,14.2 V 4.2 Z"/>
                  <TextBlock Text="Music" VerticalAlignment="Center"/>
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="NavVoice" Style="{StaticResource NavBtn}" Checked="NavChanged">
                <StackPanel Orientation="Horizontal">
                  <Path Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" Fill="{x:Null}"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                        StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        Data="M 12,3.2 A 2.6,4.2 0 0 1 12,11.6 A 2.6,4.2 0 0 1 12,3.2 M 8,10.4 A 4.2,4.2 0 0 0 16,10.4 M 12,14.6 V 20 M 9.2,20 H 14.8"/>
                  <TextBlock Text="Voice" VerticalAlignment="Center"/>
                </StackPanel>
              </RadioButton>
              <TextBlock Text="APP" Style="{StaticResource Kicker}" Margin="12,18,0,6"/>
              <RadioButton x:Name="NavDevices" Style="{StaticResource NavBtn}" Checked="NavChanged">
                <StackPanel Orientation="Horizontal">
                  <Path Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" Fill="{x:Null}"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                        StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        Data="M 5,11 A 7,7 0 0 1 19,11 M 5,11 V 15.2 A 2.2,2.2 0 0 0 7.2,17.4 H 8.2 V 11 M 19,11 V 15.2 A 2.2,2.2 0 0 1 16.8,17.4 H 15.8 V 11"/>
                  <TextBlock Text="Devices" VerticalAlignment="Center"/>
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="NavSettings" Style="{StaticResource NavBtn}" Checked="NavChanged">
                <StackPanel Orientation="Horizontal">
                  <Path Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" Fill="{x:Null}"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                        StrokeThickness="1.6" StrokeLineJoin="Round"
                        Data="M 12,8.2 A 3.2,3.2 0 1 1 12,14.6 A 3.2,3.2 0 1 1 12,8.2 M 12,3.2 V 5.2 M 12,17.6 V 19.6 M 5.8,6.4 L 7.2,7.8 M 16.8,17 L 18.2,18.4 M 3.2,12 H 5.2 M 17.6,12 H 19.6 M 5.8,17.6 L 7.2,16.2 M 16.8,7 L 18.2,5.6"/>
                  <TextBlock Text="Settings" VerticalAlignment="Center"/>
                </StackPanel>
              </RadioButton>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Grid Grid.Column="1" Panel.ZIndex="20" Background="#08FFFFFF" MouseLeftButtonDown="TitleDrag">
        <StackPanel VerticalAlignment="Center" Margin="18,0,0,0">
          <TextBlock x:Name="PageTitle" Text="Home" FontWeight="SemiBold" FontSize="14"/>
          <TextBlock Text="Cuebox" Style="{StaticResource Caption}" Margin="0,1,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
          <Button Style="{StaticResource GhostBtn}" Click="MinClick" ToolTip="Minimize">
            <Path Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.7" StrokeStartLineCap="Round"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  Data="M 2,7 H 12"/>
          </Button>
          <Button x:Name="MaxBtn" Style="{StaticResource GhostBtn}" Click="MaxClick" ToolTip="Maximize">
            <Path Width="12" Height="12" Stretch="Uniform" Fill="{x:Null}" StrokeThickness="1.5" StrokeLineJoin="Round"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  Data="M 3,3 H 13 V 13 H 3 Z"/>
          </Button>
          <Button Style="{StaticResource CloseBtn}" Click="CloseClick" ToolTip="Close">
            <Path Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.7" StrokeStartLineCap="Round"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  Data="M 3,3 L 11,11 M 11,3 L 3,11"/>
          </Button>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Grid.Column="1" ClipToBounds="True" Margin="18,8,18,10">
        <ContentControl x:Name="Host" RenderTransformOrigin="0,0">
          <ContentControl.RenderTransform>
            <TranslateTransform x:Name="HostSlide" X="0" Y="0"/>
          </ContentControl.RenderTransform>
        </ContentControl>
      </Grid>

      <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#E012141C" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0"
              WindowChrome.IsHitTestVisibleInChrome="True">
        <Grid Margin="16,8,16,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="120"/>
          </Grid.ColumnDefinitions>

          <DockPanel>
            <Border Width="72" Height="72" CornerRadius="12" Background="#22FFFFFF" ClipToBounds="True" DockPanel.Dock="Left">
              <Image x:Name="ArtImage" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                  <ScaleTransform x:Name="ArtScale" ScaleX="1" ScaleY="1"/>
                </Image.RenderTransform>
              </Image>
            </Border>
            <StackPanel VerticalAlignment="Center" Margin="12,0,10,0">
              <TextBlock x:Name="NowTitle" Text="Nothing playing" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="NowArtist" Text="Queue a file or paste a link" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
            </StackPanel>
          </DockPanel>

          <StackPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="520" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
              <Button Style="{StaticResource SkipBtn}" Click="PrevClick" ToolTip="Previous">
                <Path Fill="{DynamicResource TextBrush}" Stretch="Uniform" Width="16" Height="14"
                      Data="M 0,0 L 0,14 L 2.4,14 L 2.4,0 Z M 4,7 L 16,1.2 L 16,12.8 Z"/>
              </Button>
              <Button x:Name="PlayBtn" Style="{StaticResource PlayBtn}" Click="PlayClick" ToolTip="Play" Margin="10,0">
                <Path x:Name="PlayIcon" Fill="{DynamicResource AccentDarkBrush}" Stretch="Uniform" Width="16" Height="16"
                      Data="M 8,4 L 20,12 L 8,20 Z"/>
              </Button>
              <Button Style="{StaticResource SkipBtn}" Click="NextClick" ToolTip="Next">
                <Path Fill="{DynamicResource TextBrush}" Stretch="Uniform" Width="16" Height="14"
                      Data="M 0,1.2 L 12,7 L 0,12.8 Z M 13.6,0 L 16,0 L 16,14 L 13.6,14 Z"/>
              </Button>
            </StackPanel>
            <DockPanel>
              <TextBlock x:Name="ChromePos" DockPanel.Dock="Left" Text="0:00" Style="{StaticResource Caption}" Width="40" VerticalAlignment="Center"/>
              <TextBlock x:Name="ChromeDur" DockPanel.Dock="Right" Text="0:00" Style="{StaticResource Caption}" Width="40" TextAlignment="Right" VerticalAlignment="Center"/>
              <Border x:Name="ChromeSeekWell" Height="5" Margin="10,0" Background="#28FFFFFF" CornerRadius="3" Cursor="Hand"
                      MouseLeftButtonDown="ChromeSeekClick" VerticalAlignment="Center">
                <Border x:Name="ChromeSeekFill" Width="0" Height="5" HorizontalAlignment="Left" CornerRadius="3"
                        Background="{DynamicResource AccentBrush}" IsHitTestVisible="False"/>
              </Border>
            </DockPanel>
          </StackPanel>

          <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button x:Name="ChromeShuffle" Style="{StaticResource IconBtn}" Click="ShuffleClick" ToolTip="Shuffle" Margin="0,0,6,0">
              <Path Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    Fill="{x:Null}" Stretch="Uniform" Width="15" Height="13"
                    Data="M 1,3 H 5.5 L 11.5,11 H 17 M 14.5,8.5 L 17,11 L 14.5,13.5 M 1,11 H 5.5 L 7.5,8.8 M 11.5,3 H 17 M 14.5,0.5 L 17,3 L 14.5,5.5"/>
            </Button>
            <Button x:Name="ChromeLoop" Style="{StaticResource IconBtn}" Click="LoopClick" ToolTip="Loop">
              <Grid Width="18" Height="16">
                <Path Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Fill="{x:Null}" Stretch="Uniform" Width="15" Height="13"
                      Data="M 13,3 H 6.5 A 3.5,3.5 0 0 0 3,6.5 V 7.5 M 13,3 L 11,1.2 M 13,3 L 11,4.8 M 5,11 H 11.5 A 3.5,3.5 0 0 0 15,7.5 V 6.5 M 5,11 L 7,9.2 M 5,11 L 7,12.8"/>
                <TextBlock x:Name="LoopOne" Text="1" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
              </Grid>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="3" Grid.ColumnSpan="2" Background="#E00C0E12" BorderBrush="#12FFFFFF" BorderThickness="0,1,0,0">
        <Grid Margin="14,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="VirtDot" Width="6" Height="6" Fill="#666" Margin="0,0,7,0"/>
            <TextBlock x:Name="VirtText" Text="no cable" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
            <Border x:Name="MicLivePill" Visibility="Collapsed" Background="{DynamicResource AccentGhostBrush}" CornerRadius="6" Padding="7,1" Margin="12,0,0,0">
              <TextBlock x:Name="MicLive" Text="mic" FontSize="11" Foreground="{DynamicResource AccentSoftBrush}"/>
            </Border>
          </StackPanel>
          <TextBlock x:Name="ToastText" Grid.Column="1" Margin="16,0" VerticalAlignment="Center" FontSize="11"
                     Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" TextAlignment="Center" Opacity="0"/>
          <TextBlock x:Name="LatencyText" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource Caption}"/>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
