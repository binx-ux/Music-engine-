<Window x:Class="Mixline.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cuebox"
        Height="860" Width="1320" MinHeight="700" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="Transparent"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        FontSize="13"
        StateChanged="WinState">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="8" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Border BorderBrush="{DynamicResource WindowEdge}" BorderThickness="1" CornerRadius="8" Background="#1A000000">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="56"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="32"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="168"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.RowSpan="3" Grid.ColumnSpan="2" Background="{DynamicResource WindowSheen}" IsHitTestVisible="False"/>
      <Border Grid.RowSpan="3" Grid.ColumnSpan="2" Background="{StaticResource GrainBrush}" Opacity="0.04" IsHitTestVisible="False"/>

      <Grid Grid.ColumnSpan="2" Panel.ZIndex="20" Background="#12000000" MouseLeftButtonDown="TitleDrag">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="168"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
          <Border Width="20" Height="20" CornerRadius="5" ClipToBounds="True" Margin="0,0,8,0">
            <Image Source="Assets/cuebox.png" Stretch="UniformToFill"/>
          </Border>
          <TextBlock Text="Cuebox" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Column="1" Style="{StaticResource GlassTight}" Padding="6,4,6,5" Margin="4,6,10,6"
                WindowChrome.IsHitTestVisibleInChrome="True">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="28" Height="28" CornerRadius="5" Background="#22000000" ClipToBounds="True">
              <Image x:Name="ArtImage" Stretch="UniformToFill"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,10,0">
              <TextBlock x:Name="NowTitle" Text="Nothing playing" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="NowArtist" Text="Queue a file or paste a link" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Style="{StaticResource IconBtn}" Click="PrevClick" ToolTip="Previous" Margin="0,0,5,0"
                      WindowChrome.IsHitTestVisibleInChrome="True">
                <Path Fill="{DynamicResource TextBrush}" Data="M 4,8 L 4,16 L 6,16 L 6,8 Z M 7,12 L 15,7 L 15,17 Z"/>
              </Button>
              <Button x:Name="PlayBtn" Style="{StaticResource PlayBtn}" Click="PlayClick" ToolTip="Play"
                      WindowChrome.IsHitTestVisibleInChrome="True">
                <Path x:Name="PlayIcon" Fill="{DynamicResource AccentDarkBrush}" Data="M 8,7 L 8,17 L 16,12 Z"/>
              </Button>
              <Button Style="{StaticResource IconBtn}" Click="NextClick" ToolTip="Next" Margin="5,0,0,0"
                      WindowChrome.IsHitTestVisibleInChrome="True">
                <Path Fill="{DynamicResource TextBrush}" Data="M 5,7 L 13,12 L 5,17 Z M 14,8 L 16,8 L 16,16 L 14,16 Z"/>
              </Button>
            </StackPanel>
            <Border x:Name="ChromeSeekWell" Grid.Row="1" Grid.ColumnSpan="3" Height="3" Margin="0,5,0,0"
                    Background="#22000000" CornerRadius="1" Cursor="Hand" MouseLeftButtonDown="ChromeSeekClick"
                    WindowChrome.IsHitTestVisibleInChrome="True">
              <Border x:Name="ChromeSeekFill" Width="0" Height="3" HorizontalAlignment="Left" CornerRadius="1"
                      Background="{DynamicResource AccentBrush}" IsHitTestVisible="False"/>
            </Border>
          </Grid>
        </Border>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
          <Button Content="—" Style="{StaticResource GhostBtn}" Click="MinClick"/>
          <Button x:Name="MaxBtn" Content="▢" Style="{StaticResource GhostBtn}" Click="MaxClick"/>
          <Button Content="✕" Style="{StaticResource CloseBtn}" Click="CloseClick"/>
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" BorderBrush="#14FFFFFF" BorderThickness="0,0,1,0" Background="#0A000000">
        <StackPanel Margin="6,8,6,10">
          <RadioButton x:Name="NavHome" Content="Home" Style="{StaticResource NavBtn}" Checked="NavChanged" IsChecked="True"/>
          <RadioButton x:Name="NavMixer" Content="Mixer" Style="{StaticResource NavBtn}" Checked="NavChanged"/>
          <RadioButton x:Name="NavBoard" Content="Board" Style="{StaticResource NavBtn}" Checked="NavChanged"/>
          <RadioButton x:Name="NavMusic" Content="Music" Style="{StaticResource NavBtn}" Checked="NavChanged"/>
          <RadioButton x:Name="NavVoice" Content="Voice" Style="{StaticResource NavBtn}" Checked="NavChanged"/>
          <RadioButton x:Name="NavDevices" Content="Devices" Style="{StaticResource NavBtn}" Checked="NavChanged"/>
          <RadioButton x:Name="NavSettings" Content="Settings" Style="{StaticResource NavBtn}" Checked="NavChanged"/>
        </StackPanel>
      </Border>

      <ContentControl x:Name="Host" Grid.Row="1" Grid.Column="1" Margin="14,8,14,8"/>

      <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0" Background="#10000000">
        <Grid Margin="14,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="VirtDot" Width="6" Height="6" Fill="#666" Margin="0,0,7,0"/>
            <TextBlock x:Name="VirtText" Text="no cable" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
            <Border x:Name="MicLivePill" Visibility="Collapsed" Background="{DynamicResource AccentGhostBrush}" CornerRadius="6" Padding="7,1" Margin="12,0,0,0">
              <TextBlock x:Name="MicLive" Text="mic" FontSize="11" Foreground="{DynamicResource AccentSoftBrush}"/>
            </Border>
          </StackPanel>
          <TextBlock x:Name="ToastText" Grid.Column="1" Margin="16,0" VerticalAlignment="Center" FontSize="11"
                     Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
          <TextBlock x:Name="LatencyText" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource Caption}"/>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
