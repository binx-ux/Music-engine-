<UserControl x:Class="Mixline.App.Views.MusicView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Drop="FileDrop" DragOver="FileOver">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="300"/>
    </Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,12,0">
      <DockPanel>
        <TextBlock Text="Music" Style="{StaticResource Title}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Add files" Style="{StaticResource QuietBtn}" Click="AddFiles" Margin="0,0,8,0"/>
          <Button Content="Add folder" Style="{StaticResource QuietBtn}" Click="AddFolder"/>
        </StackPanel>
      </DockPanel>
      <TextBlock Text="Drop files or a folder here." Style="{StaticResource Caption}" Margin="0,4,0,0"/>
      <ListBox x:Name="QueueList" Margin="0,12,0,0" Height="420" MouseDoubleClick="QueuePlay"
               Background="#14000000" Foreground="#E7E9ED" BorderBrush="#28FFFFFF"/>
      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
        <Button Content="Play" Style="{StaticResource AccentBtn}" Click="Play" Margin="0,0,8,0"/>
        <Button Content="Pause" Style="{StaticResource QuietBtn}" Click="Pause" Margin="0,0,8,0"/>
        <Button Content="Stop" Style="{StaticResource QuietBtn}" Click="Stop" Margin="0,0,8,0"/>
        <CheckBox x:Name="Shuffle" Content="Shuffle" VerticalAlignment="Center" Margin="8,0" Checked="Flags" Unchecked="Flags"/>
        <ComboBox x:Name="Loop" Width="120" SelectionChanged="LoopChanged">
          <ComboBoxItem Content="Loop off"/>
          <ComboBoxItem Content="Loop one"/>
          <ComboBoxItem Content="Loop all"/>
        </ComboBox>
      </StackPanel>
      <Slider x:Name="Seek" Minimum="0" Maximum="1" Margin="0,12,0,0" PreviewMouseUp="Seeked"/>
      <TextBlock x:Name="PosText" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
    </StackPanel>
    <Border Grid.Column="1" Style="{StaticResource Glass}">
      <StackPanel>
        <TextBlock Text="URL" Style="{StaticResource Caption}"/>
        <TextBox x:Name="UrlBox" Margin="0,8,0,8"/>
        <Button Content="Load URL" Style="{StaticResource QuietBtn}" Click="LoadUrl"/>
        <TextBlock x:Name="UrlStatus" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <TextBlock Text="Spotify" Style="{StaticResource Caption}" Margin="0,18,0,8"/>
        <TextBlock Text="Connect on the Settings page. Cuebox can show now playing and control an existing Spotify player. Encrypted Spotify audio cannot be mixed into the virtual microphone." TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <Button Content="Spotify play" Style="{StaticResource QuietBtn}" Click="SpPlay" Margin="0,0,6,0"/>
          <Button Content="Pause" Style="{StaticResource QuietBtn}" Click="SpPause"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
