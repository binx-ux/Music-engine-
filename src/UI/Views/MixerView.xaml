<UserControl x:Class="Mixline.App.Views.MixerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Mixline.App.Views">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,10">
      <TextBlock Text="Mixer" Style="{StaticResource Title}"/>
      <TextBlock Text="Independent monitor and virtual-mic sends." Style="{StaticResource Caption}" Margin="0,4,0,0"/>
    </StackPanel>
    <Border Grid.Row="1" Style="{StaticResource Glass}">
      <views:MixerStrip x:Name="Strip"/>
    </Border>
    <Grid Grid.Row="2" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource Glass}" Margin="0,0,8,0">
        <StackPanel>
          <TextBlock Text="MONITOR" Style="{StaticResource Caption}"/>
          <CheckBox x:Name="MicMon" Content="Mic monitor" Margin="0,10,0,0" Checked="SendsChanged" Unchecked="SendsChanged"/>
          <CheckBox x:Name="MusicMon" Content="Music monitor" Checked="SendsChanged" Unchecked="SendsChanged"/>
          <CheckBox x:Name="BoardMon" Content="Soundboard monitor" Checked="SendsChanged" Unchecked="SendsChanged"/>
          <CheckBox x:Name="MasterMon" Content="Master monitor" Checked="SendsChanged" Unchecked="SendsChanged"/>
          <TextBlock Text="Monitor volume" Style="{StaticResource Caption}" Margin="0,12,0,4"/>
          <Slider x:Name="MonVol" Minimum="0" Maximum="1.5" ValueChanged="SliderChanged"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource Glass}" Margin="8,0,0,0">
        <StackPanel>
          <TextBlock Text="VIRTUAL SENDS" Style="{StaticResource Caption}"/>
          <TextBlock Text="Mic to virtual mic" Style="{StaticResource Caption}" Margin="0,12,0,4"/>
          <Slider x:Name="MicVirt" Minimum="0" Maximum="1.5" ValueChanged="SliderChanged"/>
          <TextBlock Text="Music to virtual mic" Style="{StaticResource Caption}" Margin="0,8,0,4"/>
          <Slider x:Name="MusicVirt" Minimum="0" Maximum="1.5" ValueChanged="SliderChanged"/>
          <TextBlock Text="Soundboard to virtual mic" Style="{StaticResource Caption}" Margin="0,8,0,4"/>
          <Slider x:Name="BoardVirt" Minimum="0" Maximum="1.5" ValueChanged="SliderChanged"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
