<UserControl x:Class="Mixline.App.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <DockPanel Margin="0,0,0,4">
        <TextBlock Text="Devices" Style="{StaticResource Title}"/>
        <Button Content="Refresh" Style="{StaticResource QuietBtn}" HorizontalAlignment="Right" Click="Refresh"/>
      </DockPanel>
      <TextBlock Text="Change these without restarting Cuebox." Style="{StaticResource Caption}" Margin="0,0,0,14"/>
      <Border Style="{StaticResource Glass}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="MICROPHONE" Style="{StaticResource Caption}"/>
          <ComboBox x:Name="Inputs" Margin="0,8,0,0" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Apply"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Glass}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="HEADPHONES / SPEAKERS" Style="{StaticResource Caption}"/>
          <ComboBox x:Name="Outputs" Margin="0,8,0,0" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Apply"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Glass}">
        <StackPanel>
          <TextBlock Text="VIRTUAL MIC DRIVER" Style="{StaticResource Caption}"/>
          <TextBlock Text="Games hear Cuebox through VB-Audio Cable. Pick CABLE Output as the microphone. Cuebox does not inject into games." Style="{StaticResource Caption}" Margin="0,6,0,10" TextWrapping="Wrap" FontWeight="Normal"/>
          <ComboBox x:Name="Virtuals" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Apply"/>
          <CheckBox x:Name="GameMic" Content="Set as Windows / game microphone" Margin="0,10,0,8" Checked="Apply" Unchecked="Apply"/>
          <TextBlock x:Name="Hint" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Use for games" Style="{StaticResource AccentBtn}" Click="UseForGames"/>
            <Button Content="Get VB-Audio Cable" Style="{StaticResource QuietBtn}" Margin="8,0,0,0" Click="GetCable"/>
          </StackPanel>
          <Button Content="Restart audio" Style="{StaticResource QuietBtn}" Margin="0,8,0,0" HorizontalAlignment="Left" Click="Restart"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
