<UserControl x:Class="Mixline.App.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <DockPanel Margin="0,0,0,4">
      <TextBlock Text="Devices" Style="{StaticResource Title}"/>
      <Button Content="Refresh" Style="{StaticResource QuietBtn}" HorizontalAlignment="Right" Click="Refresh"/>
    </DockPanel>
    <TextBlock Text="Change these without restarting Cuebox." Style="{StaticResource Caption}" Margin="0,0,0,14"/>
    <Border Style="{StaticResource Glass}" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="MICROPHONE" Style="{StaticResource Caption}"/>
        <ComboBox x:Name="Inputs" Margin="0,8,0,0" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Apply"/>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Glass}" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="HEADPHONES / SPEAKERS" Style="{StaticResource Caption}"/>
        <ComboBox x:Name="Outputs" Margin="0,8,0,0" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Apply"/>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Glass}">
      <StackPanel>
        <TextBlock Text="VIRTUAL OUTPUT" Style="{StaticResource Caption}"/>
        <ComboBox x:Name="Virtuals" Margin="0,8,0,8" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Apply"/>
        <TextBlock x:Name="Hint" TextWrapping="Wrap"/>
        <Button Content="Restart audio" Style="{StaticResource AccentBtn}" Margin="0,12,0,0" HorizontalAlignment="Left" Click="Restart"/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
