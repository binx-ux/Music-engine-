<UserControl x:Class="Mixline.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Mixline.App.Views"
             xmlns:c="clr-namespace:Mixline.App.Controls">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Style="{StaticResource Glass}" Padding="12" Margin="0,0,0,10">
      <StackPanel>
        <DockPanel>
          <Border x:Name="EnginePill" DockPanel.Dock="Right" CornerRadius="8" Padding="8,2" Background="#18000000" VerticalAlignment="Center">
            <TextBlock x:Name="EngineState" Style="{StaticResource Caption}"/>
          </Border>
          <TextBlock Text="MIX" Style="{StaticResource Kicker}" VerticalAlignment="Center"/>
        </DockPanel>
        <views:MixerStrip x:Name="_mixerStrip" Margin="0,6,0,6"/>
        <c:LevelMeter x:Name="MasterMeter" Height="7"/>
      </StackPanel>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="1.25*"/>
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource Glass}" Padding="12" Margin="0,0,8,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="MIC" Style="{StaticResource Kicker}"/>
            <TextBlock x:Name="MicName" Text="—" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,2"/>
            <TextBlock x:Name="OutName" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
          </StackPanel>
          <c:LevelMeter x:Name="MicMeter" Height="8" VerticalAlignment="Bottom"/>
        </DockPanel>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource Glass}" Padding="12" Margin="0,0,8,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="MUSIC" Style="{StaticResource Kicker}"/>
            <TextBlock Text="Queue, links, GitHub playlists" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,8"/>
            <Button Content="Find clean rap" Style="{StaticResource AccentBtn}" HorizontalAlignment="Left" Click="CleanRap"/>
          </StackPanel>
          <c:LevelMeter x:Name="MusicMeter" Height="8" VerticalAlignment="Bottom"/>
        </DockPanel>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource Glass}" Padding="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="PADS" Style="{StaticResource Kicker}"/>
          <ScrollViewer Grid.Row="1" Margin="0,8,0,8" VerticalScrollBarVisibility="Auto">
            <views:MiniBoardView x:Name="_miniBoard"/>
          </ScrollViewer>
          <c:LevelMeter x:Name="BoardMeter" Grid.Row="2" Height="8"/>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="2" Style="{StaticResource Glass}" Padding="14" Margin="0,10,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Use for games" Style="{StaticResource AccentBtn}" Click="UseForGames"/>
          <Button Content="Get VB-Audio Cable" Style="{StaticResource QuietBtn}" Margin="8,0,0,0" Click="GetCable"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="GAME MIC" Style="{StaticResource Kicker}"/>
          <TextBlock x:Name="VirtHint" Margin="0,6,0,0" TextWrapping="Wrap"/>
          <TextBlock x:Name="Notice" Margin="0,6,0,0" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
