<UserControl x:Class="Mixline.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Mixline.App.Views"
             xmlns:c="clr-namespace:Mixline.App.Controls">
  <StackPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="1.15*"/>
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource Glass}" Margin="0,0,12,14">
        <StackPanel>
          <TextBlock Text="MICROPHONE" Style="{StaticResource Kicker}"/>
          <TextBlock x:Name="MicName" Text="—" Style="{StaticResource Title}" FontSize="16" Margin="0,8,0,2"/>
          <TextBlock x:Name="OutName" Style="{StaticResource Caption}" Margin="0,0,0,12"/>
          <c:LevelMeter x:Name="MicMeter" Height="10" Margin="0,0,0,10"/>
          <TextBlock Text="Processing stays on this PC. Cuebox does not write recordings." Style="{StaticResource Caption}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource Glass}" Margin="0,0,12,14">
        <StackPanel>
          <TextBlock Text="MUSIC" Style="{StaticResource Kicker}"/>
          <TextBlock Text="Files mix into the virtual mic." FontSize="16" FontWeight="SemiBold" Margin="0,8,0,2"/>
          <TextBlock Text="Spotify metadata is separate." Style="{StaticResource Caption}" Margin="0,0,0,12"/>
          <c:LevelMeter x:Name="MusicMeter" Height="10"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource Glass}" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="SOUNDBOARD" Style="{StaticResource Kicker}"/>
          <views:MiniBoardView x:Name="_miniBoard" Margin="0,10,0,10"/>
          <c:LevelMeter x:Name="BoardMeter" Height="10"/>
        </StackPanel>
      </Border>
    </Grid>
    <Border Style="{StaticResource Glass}" Margin="0,0,0,14">
      <StackPanel>
        <Grid>
          <TextBlock Text="MIXER" Style="{StaticResource Kicker}"/>
          <TextBlock x:Name="EngineState" HorizontalAlignment="Right" Style="{StaticResource Caption}"/>
        </Grid>
        <views:MixerStrip x:Name="_mixerStrip" Margin="0,8,0,8"/>
        <c:LevelMeter x:Name="MasterMeter" Height="8"/>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Glass}">
      <StackPanel>
        <TextBlock Text="VIRTUAL MIC" Style="{StaticResource Kicker}"/>
        <TextBlock x:Name="VirtHint" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="20"/>
        <TextBlock x:Name="Notice" Margin="0,8,0,0" Foreground="#C45C58" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
