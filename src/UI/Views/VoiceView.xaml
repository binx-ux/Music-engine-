<UserControl x:Class="Mixline.App.Views.VoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <TextBlock Text="Voice" Style="{StaticResource Title}" Margin="0,0,0,4"/>
      <TextBlock Text="Tune, clean, then polish. Effects stay off until you turn them on." Style="{StaticResource Caption}" Margin="0,0,0,16"/>

      <Border Style="{StaticResource Glass}" Margin="0,0,0,12">
        <StackPanel>
          <DockPanel>
            <TextBlock Text="TUNE" Style="{StaticResource Kicker}" VerticalAlignment="Center"/>
            <TextBlock x:Name="TuneLive" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" FontSize="13"/>
          </DockPanel>
          <TextBlock x:Name="TuneNote" Text="—" FontSize="36" FontWeight="SemiBold" Margin="0,10,0,2"/>
          <TextBlock x:Name="TuneHz" Text="Waiting for voice" Style="{StaticResource Caption}" Margin="0,0,0,12"/>

          <TextBlock Text="Style" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
          <ComboBox x:Name="Tune" SelectionChanged="ComboChanged">
            <ComboBoxItem Content="Off"/>
            <ComboBoxItem Content="Natural"/>
            <ComboBoxItem Content="Studio"/>
            <ComboBoxItem Content="Hard"/>
          </ComboBox>

          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,6,0">
              <TextBlock Text="Key" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
              <ComboBox x:Name="TuneKey" SelectionChanged="ComboChanged"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="6,0,0,0">
              <TextBlock Text="Scale" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
              <ComboBox x:Name="TuneScale" SelectionChanged="ComboChanged"/>
            </StackPanel>
          </Grid>

          <DockPanel Margin="0,14,0,4">
            <TextBlock Text="Amount" Style="{StaticResource Caption}"/>
            <TextBlock x:Name="TuneAmtLabel" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource Caption}"/>
          </DockPanel>
          <Slider x:Name="TuneAmt" Minimum="0" Maximum="1" Value="0.75" ValueChanged="SliderChanged"/>

          <DockPanel Margin="0,10,0,4">
            <TextBlock Text="Retune speed" Style="{StaticResource Caption}"/>
            <TextBlock x:Name="TuneSpeedLabel" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource Caption}"/>
          </DockPanel>
          <Slider x:Name="TuneSpeed" Minimum="0" Maximum="1" Value="0.55" ValueChanged="SliderChanged"/>

          <CheckBox x:Name="Formant" Content="Keep formants" Margin="0,12,0,0" Checked="Changed" Unchecked="Changed"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Glass}" Margin="0,0,0,12">
        <StackPanel>
          <CheckBox x:Name="Enhance" Content="Voice Enhance" Checked="Changed" Unchecked="Changed"/>
          <TextBlock Text="High-pass, light compression, and a limiter. Leave it off if you want a dry mic." Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"/>
          <TextBlock x:Name="Live" Margin="0,10,0,0" Foreground="{DynamicResource AccentBrush}"/>
        </StackPanel>
      </Border>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Glass}" Margin="0,0,8,12">
          <StackPanel>
            <TextBlock Text="CLEAN" Style="{StaticResource Kicker}" Margin="0,0,0,10"/>
            <CheckBox x:Name="Hpf" Content="High pass" Checked="Changed" Unchecked="Changed"/>
            <TextBlock Text="Cutoff" Style="{StaticResource Caption}" Margin="0,8,0,4"/>
            <Slider x:Name="HpfHz" Minimum="40" Maximum="160" Value="80" ValueChanged="SliderChanged"/>
            <CheckBox x:Name="Gate" Content="Noise gate" Margin="0,12,0,0" Checked="Changed" Unchecked="Changed"/>
            <TextBlock Text="Threshold" Style="{StaticResource Caption}" Margin="0,8,0,4"/>
            <Slider x:Name="GateTh" Minimum="-70" Maximum="-10" Value="-42" ValueChanged="SliderChanged"/>
            <CheckBox x:Name="Nr" Content="Noise reduction" Margin="0,12,0,0" Checked="Changed" Unchecked="Changed"/>
            <Slider x:Name="NrAmt" Minimum="0" Maximum="1" Value="0.25" Margin="0,8,0,0" ValueChanged="SliderChanged"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Glass}" Margin="8,0,0,12">
          <StackPanel>
            <TextBlock Text="TONE" Style="{StaticResource Kicker}" Margin="0,0,0,10"/>
            <CheckBox x:Name="EqOn" Content="EQ" Checked="Changed" Unchecked="Changed"/>
            <ComboBox x:Name="EqPreset" Margin="0,8,0,0" SelectionChanged="PresetChanged"/>
            <CheckBox x:Name="Comp" Content="Compressor" Margin="0,12,0,0" Checked="Changed" Unchecked="Changed"/>
            <TextBlock Text="Threshold" Style="{StaticResource Caption}" Margin="0,8,0,4"/>
            <Slider x:Name="CompTh" Minimum="-40" Maximum="0" Value="-18" ValueChanged="SliderChanged"/>
            <TextBlock Text="Ratio" Style="{StaticResource Caption}" Margin="0,8,0,4"/>
            <Slider x:Name="CompRatio" Minimum="1" Maximum="12" Value="3" ValueChanged="SliderChanged"/>
            <TextBlock x:Name="Gr" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
      </Grid>

      <Border Style="{StaticResource Glass}">
        <StackPanel>
          <TextBlock Text="POLISH" Style="{StaticResource Kicker}" Margin="0,0,0,10"/>
          <CheckBox x:Name="DeEss" Content="De-esser" Checked="Changed" Unchecked="Changed"/>
          <CheckBox x:Name="Sat" Content="Saturation" Margin="0,8,0,0" Checked="Changed" Unchecked="Changed"/>
          <CheckBox x:Name="Lim" Content="Limiter" Margin="0,8,0,0" IsChecked="True" Checked="Changed" Unchecked="Changed"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
